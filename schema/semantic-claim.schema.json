{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckpt.local/schema/semantic-claim.schema.json",
  "title": "SemanticClaim",
  "description": "SPEC-004 semantic (derived) claim. Interpretation, never fact: field is restricted to semantic fields, so a claim can never set a deterministic field. A claim whose provenance arrays are all empty is rejected.",
  "type": "object",
  "required": ["field", "value", "origin", "provenance"],
  "additionalProperties": false,
  "properties": {
    "field": {
      "enum": ["goal", "plan", "decision", "assumption", "open_question", "next_action", "current_step", "current_state"]
    },
    "value": { "type": "string" },
    "origin": { "enum": ["agent_declared", "distilled", "human"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": {
      "type": "object",
      "required": ["event_ids", "artifact_refs", "workspace_paths", "checkpoint_ids"],
      "additionalProperties": false,
      "properties": {
        "event_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "workspace_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "checkpoint_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "anyOf": [
        { "properties": { "event_ids": { "minItems": 1 } } },
        { "properties": { "artifact_refs": { "minItems": 1 } } },
        { "properties": { "workspace_paths": { "minItems": 1 } } },
        { "properties": { "checkpoint_ids": { "minItems": 1 } } }
      ]
    }
  }
}
