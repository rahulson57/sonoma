{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckpt.local/schema/semantic-projection.schema.json",
  "title": "SemanticProjection",
  "description": "SPEC-007 versioned, derived projection for one checkpoint. Re-distilling creates a new projection id and never mutates an earlier one. Field names follow SPEC-007 verbatim. source (SPEC-015 amendment 3) is 'distilled' for Distiller output or 'declared' for an SDK/human declaration; distiller and usage may be null only for 'declared' (a cross-field rule enforced by validateSemanticProjection).",
  "type": "object",
  "required": ["id", "checkpointId", "source", "distiller", "input", "claims", "usage", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "checkpointId": { "$ref": "common.schema.json#/$defs/CheckpointId" },
    "source": { "enum": ["distilled", "declared"] },
    "distiller": {
      "anyOf": [
        {
          "type": "object",
          "required": ["provider", "model", "promptVersion"],
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "promptVersion": { "type": "string", "minLength": 1 }
          }
        },
        { "type": "null" }
      ]
    },
    "input": {
      "type": "object",
      "required": ["stateHash", "ledgerRange", "workspaceCommit"],
      "additionalProperties": false,
      "properties": {
        "stateHash": { "$ref": "common.schema.json#/$defs/Sha256" },
        "ledgerRange": {
          "description": "[previous checkpoint cursor (exclusive), this cursor (inclusive)].",
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "workspaceCommit": { "$ref": "common.schema.json#/$defs/GitSha" }
      }
    },
    "claims": { "type": "array", "items": { "$ref": "semantic-claim.schema.json" } },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "required": ["inputTokens", "outputTokens", "costUsd"],
          "additionalProperties": false,
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "costUsd": { "type": "number", "minimum": 0 }
          }
        },
        { "type": "null" }
      ]
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
  }
}
